{
  "expo": {
    "name": "MyHealth Vault+",
    "slug": "myvaultplus",
    "owner": "health-hub-africa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myhealthvault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myvaultplus.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSCameraUsageDescription": "MyHealth Vault+ uses your camera for TeleCare video consultations and to scan medical documents into your vault.",
        "NSMicrophoneUsageDescription": "MyHealth Vault+ needs microphone access for TeleCare video consultations.",
        "NSLocationWhenInUseUsageDescription": "MyHealth Vault+ uses your location only when you request emergency dispatch, so responders can find you."
      }
    },
    "android": {
      "package": "com.myvaultplus.app",
      "adaptiveIcon": {
        "backgroundColor": "#137333",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/87ae595a-aad6-4c25-b0e4-69331153944c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "health-hub-africa",
          "project": "myvaultplus-mobile",
          "url": "https://de.sentry.io/"
        }
      ],
      "expo-updates",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-monochrome.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#183E32"
        }
      ],
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera for TeleCare video calls and to scan medical documents",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for TeleCare video calls"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MyHealth Vault+ needs access to your photos so you can choose a profile picture.",
          "cameraPermission": "MyHealth Vault+ uses your camera for TeleCare video consultations and to scan medical documents into your vault."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#137333"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyHealth Vault+ uses your location only when you request emergency dispatch, so responders can find you."
        }
      ],
      "./plugins/withCallForegroundService"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "87ae595a-aad6-4c25-b0e4-69331153944c"
      }
    }
  }
}
